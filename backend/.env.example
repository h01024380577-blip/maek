# 아래 등호 뒤에 OpenAI API 키를 붙여 넣고 backend/.env 로 저장하세요. 따옴표 없이 값만 적습니다.
#   예) OPENAI_API_KEY=sk-...
# 저장 후 curl -X POST http://localhost:8000/api/reload 로 재기동 없이 반영됩니다.
# 비워 두면 규칙 기반 템플릿 서술로 자동 폴백합니다 (화면의 narrative_source 로 구분).
OPENAI_API_KEY=

# 선택: 서술문 생성 모델. 기본 gpt-5-mini
# MAEK_LLM_MODEL=gpt-5-mini
